# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/projeto_croche"

# ─────────────────────────────────────────
# SEGURANÇA
# ─────────────────────────────────────────
# Chave para criptografar a API key do Asaas no banco. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="gere-uma-chave-com-o-comando-acima"

# ─────────────────────────────────────────
# ASAAS
# ─────────────────────────────────────────
# API Key é configurada via painel admin (Configurações → Pagamento) — NÃO coloque aqui
# Gere um token aleatório para webhook e configure o mesmo valor no painel Asaas:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ASAAS_WEBHOOK_TOKEN="gere-um-token-secreto-aleatorio-aqui"

# ─────────────────────────────────────────
# EMAIL (Resend — resend.com)
# ─────────────────────────────────────────
RESEND_API_KEY="re_..."

# ─────────────────────────────────────────
# WHATSAPP (Z-API — z-api.io)
# ─────────────────────────────────────────
# Crie uma instância em z-api.io, conecte seu WhatsApp e copie os dados abaixo
ZAPI_INSTANCE_ID="sua-instance-id"
ZAPI_TOKEN="seu-token"
ZAPI_CLIENT_TOKEN="seu-client-token"  # opcional, mas recomendado

# ─────────────────────────────────────────
# APP
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
